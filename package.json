{
  "name": "@qrivi/kristofdewil.de",
  "version": "2.0.0",
  "private": true,
  "description": "This is my website!",
  "homepage": "https://kristofdewil.de",
  "type": "module",
  "scripts": {
    "dev": "rm -rf node_modules/.vite && rm -rf .astro && astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check && bun run fmt:check && bun run lint",
    "check:fix": "astro check && bun run fmt && bun run lint:fix",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "rm -rf ./.astro && rm -rf ./dist",
    "deps:bump": "bun update --latest # --interactive",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "rehype-external-links": "^3.0.0",
    "rehype-shift-heading": "^2.0.0",
    "remark-definition-list": "^2.0.1",
    "sanitize-html": "^2.18.0",
    "satori": "^0.62.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ]
  }
}
