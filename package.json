{
  "name": "@qrivi/kristofdewil.de",
  "version": "2.0.0",
  "private": true,
  "description": "This is my website!",
  "homepage": "https://kristofdewil.de",
  "type": "module",
  "scripts": {
    "dev": "rm -rf node_modules/.vite && rm -rf .astro && astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check && bun run fmt:check && bun run lint",
    "check:fix": "astro check && bun run fmt && bun run lint:fix",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "rm -rf ./.astro && rm -rf ./dist",
    "deps:bump": "bun update --latest # --interactive",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/ts-plugin": "^1.10.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@shikijs/rehype": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.3",
    "dayjs": "^1.11.20",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-shift-heading": "^2.0.0",
    "remark-definition-list": "^2.0.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ]
  }
}
