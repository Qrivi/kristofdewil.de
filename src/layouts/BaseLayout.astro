---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import DocumentHead from "../components/DocumentHead.astro";

type Props = {
  title?: string;
};
const {title}: Props = Astro.props;
---

<html lang="en">
  <DocumentHead title={title}/>
  <body>
    <header class="wrapper mesh -top-30 sticky z-50 bg-linear-to-b from-background via-background to-transparent via-80%">
      <div class="mesh-center flex flex-col-reverse">
        <hgroup class="pt-4">
          <h1>Kristof Dewilde</h1>
          <p>Consultant Software Engineer</p>
        </hgroup>
        <nav class="border-b border-foreground/5 py-4 sticky top-0 bg-background">
          <ul class="flex items-center uppercase text-xs gap-6">
            <li class="rounded aspect-square w-10 overflow-clip bg-primary mr-2">
              <a href="/"> <img alt="Kristof Dewilde" src="/kristof.jpeg" class="object-cover w-full h-full hover:opacity-0 transition-opacity duration-500"> </a>
            </li>
            <li><a href="/resume">resume</a></li>
            <li><a href="/posts">blog</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot/>
    </main>

    <footer class="wrapper pb-0 mesh sticky bottom-0 z-50 bg-linear-to-t from-background via-background to-transparent via-60%">
      <div class="mesh-center border-t border-foreground/5 text-xs py-4 bg-background">Copyright © {new Date().getFullYear()} Kristof Dewilde</div>
    </footer>
  </body>
</html>
