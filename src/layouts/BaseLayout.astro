---
import "../styles/global.css";
import PageHeader from "~/components/PageHeader.astro";
import DocumentHead from "../components/DocumentHead.astro";
import Font from "astro/components/Font.astro";

type Props = {
  title?: string;
};
const {title}: Props = Astro.props;
---

<Font cssVariable="--font-value-sans" preload />
<Font cssVariable="--font-value-mono" preload />

<html lang="en">
  <DocumentHead title={title}/>
  <body>
    <PageHeader />

    <main>
      <slot/>
    </main>

    <footer class="wrapper pb-0 mesh sticky bottom-0 z-50 bg-linear-to-t from-background via-background to-transparent via-60%">
      <div class="mesh-center border-t border-foreground/5 text-xs py-4 bg-background">Copyright © {new Date().getFullYear()} Kristof Dewilde</div>
    </footer>
  </body>
</html>
