---
import "../styles/global.css";
import PageHeader from "~/components/PageHeader.astro";
import PageFooter from "~/components/PageFooter.astro";
import DocumentHead from "../components/DocumentHead.astro";
import Font from "astro/components/Font.astro";
import { ClientRouter, fade } from "astro:transitions";
import type { PageStructuredData } from "~/utils/structured-data";

type Props = {
  title?: string;
  description?: string;
  structuredData?: PageStructuredData;
};
const {title, description, structuredData}: Props = Astro.props;
---

<html lang="en" transition:name="root" transition:animate={fade({ duration: "250ms" })}>
  <DocumentHead title={title} description={description} structuredData={structuredData}>
    <Font cssVariable="--font-value-sans" preload />
    <Font cssVariable="--font-value-serif" preload />
    <Font cssVariable="--font-value-mono" preload />

    <ClientRouter/>
  </DocumentHead>

  <body>
    <PageHeader isHomePage={Astro.url.pathname === "/"}/>

    <main>
      <slot/>
    </main>

    <PageFooter/>
  </body>
</html>

<script>
  let cleanup: (() => void) | undefined;

  // Update direction and edge proximity together so bars never hide inside the buffer.
  function setupScrollDirection() {
    cleanup?.();

    const root = document.documentElement;
    delete root.dataset.scrollDirection;

    // Distance from top and bottom when in viewport always shows header and footer
    const edgeBuffer = 150;

    const controller = new AbortController();
    let previousY = Math.max(0, window.scrollY);
    let frame = 0;

    function updateDirection() {
      frame = 0;
      // Clamp Safari's rubber-band scrolling at both ends.
      const maxY = Math.max(0, root.scrollHeight - window.innerHeight);
      const currentY = Math.min(maxY, Math.max(0, window.scrollY));
      const delta = currentY - previousY;

      root.toggleAttribute("data-near-top", currentY <= edgeBuffer);
      root.toggleAttribute("data-near-bottom", maxY - currentY <= edgeBuffer);

      if (currentY === 0) {
        delete root.dataset.scrollDirection;
        previousY = currentY;
      } else if (Math.abs(delta) >= 4) {
        root.dataset.scrollDirection = delta > 0 ? "down" : "up";
        previousY = currentY;
      }
    }

    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(updateDirection);
    }

    function handleScroll() {
      document.querySelectorAll<HTMLElement>("[popover]:popover-open").forEach(panel => panel.hidePopover());
      scheduleUpdate();
    }

    window.addEventListener("scroll", handleScroll, { passive: true, signal: controller.signal });
    window.addEventListener("resize", scheduleUpdate, { signal: controller.signal });
    updateDirection();

    cleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
      delete root.dataset.scrollDirection;
      root.removeAttribute("data-near-top");
      root.removeAttribute("data-near-bottom");
      cleanup = undefined;
    };
  }

  document.addEventListener("astro:page-load", setupScrollDirection);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>

