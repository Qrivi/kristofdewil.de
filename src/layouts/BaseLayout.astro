---
import DotCursor from "@components/DotCursor.vue";
import Header from "@components/Header.astro";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/material-icons-outlined";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const defaultTitle = "Kristof Dewilde";

const pageTitle = title ? `${title} • ${defaultTitle}` : defaultTitle;
---

<style is:global>
  :root {
    --light-background: 255 255 255;
    --light-text: 32 32 32;
    --light-accent: 250 170 20;

    --dark-background: 32 32 32;
    --dark-text: 240 240 255;
    --dark-accent: 250 170 20;

    --font-sans: "Inter Variable", Inter, system-ui, sans-serif;
    --font-monospace: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
    --font-icons: "Material Icons Outlined", ui-monospace, monospace;
  }

  ::selection {
    background: var(--color-accent);
    color: var(--color-text);
  }

  @media (prefers-reduced-motion) {
    * {
      animation-duration: 0ms !important;
      transition-duration: 0ms !important;
      animation-delay: 0ms !important;
      transition-delay: 0ms !important;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    overflow-wrap: break-word;
    font: inherit;
  }

  body {
    scroll-behavior: smooth;
    max-width: 100vw;
    min-height: 100dvh;
    border-radius: 15px;
    overflow-x: hidden;
    background-color: var(--color-background);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;

    &.light {
      color-scheme: light;
      --color-background: rgb(var(--light-background) / 1);
      --color-background-accent: rgb(var(--light-accent) / 0.15);
      --color-text: rgb(var(--light-text) / 1);
      --color-text-muted: rgb(var(--light-text) / 0.75);
      --color-accent: rgb(var(--light-accent) / 1);
    }

    &.dark {
      color-scheme: dark;
      --color-background: rgb(var(--dark-background) / 1);
      --color-background-accent: rgb(var(--dark-accent) / 0.15);
      --color-text: rgb(var(--dark-text) / 1);
      --color-text-muted: rgb(var(--dark-text) / 0.75);
      --color-accent: rgb(var(--dark-accent) / 1);

      .shiki,
      .shiki span,
      .shiki span::before {
        color: var(--shiki-dark) !important;
        background-color: var(--shiki-dark-bg) !important;
      }
    }
  }

  #page {
    --padding-page: 100px;
    --padding-content: 20px;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--padding-page) var(--padding-content);
    gap: var(--padding-content);

    .sticky {
      position: sticky;
      top: var(--padding-page);
      display: flex;
      flex-direction: column;
      max-height: 100dvh;
    }
  }

  a,
  .clickable {
    color: var(--color-text);
    text-decoration: none;
    transition:
      color 0.2s ease-in-out,
      opacity 0.2s ease-in-out;

    &:hover {
      opacity: 0.5 !important;
    }

    &:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
    &:active {
      opacity: 1 !important;
      color: var(--color-accent) !important;
    }

    &.underline {
      transition: background-size 250ms ease-out;
      background: linear-gradient(var(--color-accent), var(--color-accent)) no-repeat left 123%/0 9px;

      &:hover {
        opacity: 1 !important;
        background-size: 95% 9px;
      }
    }
  }

  .icon {
    font-family: var(--font-icons);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;

    list-style: none;
    padding: 3px 0;
    font-size: 0.8em;

    li {
      border-radius: 5px;
      padding: 0 5px;
      font-family: var(--font-monospace);
      background-color: var(--color-background-accent);
      color: var(--color-accent);
    }
  }
</style>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="dark custom-cursor">
    <div id="page">
      <header>
        <div class="sticky">
          <Header />
          <nav>
            <ul>
              <li>Experience</li>
              <li>Blog</li>
            </ul>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <DotCursor client:idle />
  </body>
</html>
