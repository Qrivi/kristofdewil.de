---
import "../styles/screen.scss";
import "../styles/post.scss";
import Header from "../components/Header.astro";
import PageWrapper from "../components/ContentWrapper.astro";
import Footer from "../components/Footer.astro";

const { content: fm } = Astro.props;
const formattedDate = new Date(fm.published).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>kristofdewil.de</title>
  </head>
  <body>
    <Header />
    <main class="post">
      <header>
        <div>
          <h1>{fm.title}</h1>
          <ul>
            {
              fm.tags.map((tag: string) => (
                <li>
                  <a href={`${Astro.url}/tags/${tag}`}>{tag}</a>
                </li>
              ))
            }
          </ul>
          <time datetime={fm.published}>{formattedDate}</time>
        </div>
        <figure>
          <img src={`/images/${fm.banner}`} alt="" />
        </figure>
      </header>
      <p class="description">{fm.description}</p>
      <slot />
    </main>
    <Footer />
  </body>
</html>
