---
import ContentWrapper from "./ContentWrapper.astro";
import SiteName from "./SiteName.astro";
---

<ContentWrapper>
  <header>
    <SiteName />
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="#">Ur mom</a></li>
      </ul>
    </nav>
  </header>
</ContentWrapper>

<style lang="scss">
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    nav ul {
      display: flex;
      column-gap: 2rem;
      list-style-type: none;
      margin: 0;
      padding: 0;

      a {
        position: relative;
        color: var(--color-title);

        &:hover::before,
        &.active {
          opacity: 1;
        }

        &::before {
          position: absolute;
          top: -1.1em;
          left: 0;
          right: 0;
          opacity: 0;
          color: var(--color-accent);
          font-size: 25px;
          text-align: center;
          transition: opacity 500ms ease-out;
          content: "•";
        }
      }
    }
  }
</style>
