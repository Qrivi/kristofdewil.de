---
import type { MarkdownInstance } from "astro";

interface PostTileProps {
  post: MarkdownInstance<Record<string, any>>;
  index?: number;
}

const { post, index } = Astro.props as PostTileProps;
const { frontmatter: fm } = post;
const formattedDate = new Date(fm.published).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const delay = index ? 50 * (index + 1) : 50;
---

<li class="tile" style={`animation-delay: ${delay}ms;`}>
  <article>
    <h1>
      <a href={post.url} title={fm.title}>{fm.title}</a>
    </h1>
    <p>{fm.description}</p>
    <ul>
      {
        fm.tags.map((tag: string) => (
          <li>
            <a href={`/tags/${tag}`}>{tag}</a>
          </li>
        ))
      }
    </ul>
    <time datetime={fm.published}>{formattedDate}</time>
  </article>
  <figure>
    <img src={`/images/${fm.banner}`} alt={fm.title} loading="lazy" />
  </figure>
</li>

<style lang="scss">
  li.tile {
    position: relative;
    overflow: hidden;
    min-height: 340px;
    padding: 30px;
    border-radius: 1.5rem;
    transition: transform 200ms ease-out;
    opacity: 0;
    animation: 500ms ease-out 250ms forwards normal tile;

    @keyframes tile {
      0% {
        opacity: 0;
        transform: translateY(15px);
      }
      100% {
        opacity: 1;
        transform: none;
      }
    }

    &:hover {
      transform: translateY(-5px);
    }

    figure {
      position: absolute;
      z-index: 1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      margin: 0;
      padding: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &::before {
      position: absolute;
      z-index: 2;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: var(--color-background);
      opacity: 0.8;
      transition: opacity 500ms ease-in-out;
      content: "";
    }

    &::after {
      position: absolute;
      z-index: 2;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: var(--color-background-lighter);
      opacity: 0.15;
      content: "";
    }

    &:hover::before {
      opacity: 0.6;
    }

    article {
      position: relative;
      z-index: 3;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;

      h1 {
        padding: 0.6em 0;
        font-family: var(--font-title);
        font-size: 1.4em;
        font-weight: 600;
        color: var(--color-title);

        a {
          color: var(--color-title);

          &::after {
            display: inline-block;
            font-family: var(--font-icons);
            content: "arrow_right_alt";
            opacity: 0;
            transform: translate(0.1em, 0.15em);
            transition: transform 100ms, opacity 100ms;
          }

          &:hover::after {
            opacity: 1;
            transform: translate(0.4em, 0.15em);
          }
        }
      }

      p {
        font-size: 0.9em;
      }

      time {
        font-size: 0.9em;
        text-align: right;
        color: var(--color-title);
      }

      ul {
        order: -1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.3em;

        li {
          background: var(--color-accent);
          color: var(--color-title);
          border-radius: 100px;
          font-family: var(--font-title);
          font-size: 0.69em;
          line-height: 1em;
          font-weight: 600;
          text-transform: uppercase;
          transition: opacity 200ms;

          &:hover {
            opacity: 0.8;
          }

          a {
            display: inline-block;
            padding: 0.6em 1.2em;
            color: var(--color-title);
          }
        }
      }
    }
  }
</style>
