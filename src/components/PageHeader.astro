---
type Props = {
  isHomePage?: boolean;
};

const { isHomePage = false }: Props = Astro.props;

const IdentityGroup = isHomePage ? "hgroup" : "div";
const Name = isHomePage ? "h1" : "p";

const menu = [
  { title: "Career", href: "/career" },
  { title: "Blog", href: "/blog" },
];
---

<header class="page-header group/header pt-2 mesh top-0 sticky z-50">
  <div class="mesh-center flex items-center gap-4 border-b border-foreground/10 py-4">
    <a href="/" class="rounded aspect-square w-10 shrink-0 overflow-clip bg-primary after:hidden"><img alt="Kristof Dewilde — home" src="/kristof.jpeg" class="object-cover w-full h-full grayscale group-hover/header:grayscale-0 hover:opacity-0 transition-[filter,opacity] duration-500"></a>
    <IdentityGroup class="min-w-0 flex flex-col gap-2">
      <Name class="text-box-trim text-base font-semibold text-foreground pb-0">Kristof Dewilde</Name>
      <p class="text-box-trim pb-0" data-header-subtitle transition:persist="header-subtitle">Consultant Software Engineer</p>
    </IdentityGroup>
    <nav aria-label="Main" class="header-desktop-nav ml-auto">
    <ul class="flex items-center uppercase text-xs gap-6 pb-0">
      {menu.map(item => (
        <li>
          <a class="item-indicator font-mono" href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.title}</a>
        </li>
      ))}
    </ul>
    </nav>
    <header-navigation class="ml-auto shrink-0 hidden">
      <button type="button" popovertarget="header-navigation-panel" aria-label="Toggle navigation" class="header-navigation-trigger flex size-11 items-center justify-center rounded text-foreground/70 hover:bg-foreground/5 hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary">
        <svg class="menu-open" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="menu-close hidden" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="m6 6 12 12M6 18 18 6" />
        </svg>
      </button>
      <nav id="header-navigation-panel" popover="auto" aria-label="Main" class="header-navigation-panel m-0 rounded-md border border-foreground/10 bg-background p-2 text-xs text-foreground/70 shadow-lg">
        <ul class="p-0 text-right text-xs">
          {menu.map(item => (
            <li><a class="inline-flex min-h-11 items-center gap-x-1 px-3 uppercase transition-colors duration-500 hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary" href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.title}</a></li>
          ))}
        </ul>
      </nav>
    </header-navigation>
  </div>
</header>

<script>
  class HeaderNavigation extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const panel = this.querySelector<HTMLElement>("[popover]")!;
      window.matchMedia("(max-width: 55rem)").addEventListener("change", event => {
        if (!event.matches && panel.matches(":popover-open")) panel.hidePopover();
      }, { signal: this.controller.signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get("header-navigation")) customElements.define("header-navigation", HeaderNavigation);

  const subtitles = [
    // "Consultant Software Engineer",
    "Backend brain, frontend curiosity",
    "Turning coffee into software",
    "Down another technical rabbit hole",
    "Making complex things feel simple",
    "Probably thinking about edge cases",
    "Just one more refactor, I promise",
    "Professionally suspicious of timezones",
    "Debugging by educated guessing",
    "Currently overthinking a side project",
    "Adding logs until it makes sense",
    "2014 Web Ninja Engineer",
    "The fix was a missing comma",
    "Estimating in optimistic units",
    "Reading docs after trying all else",
    "Accidentally learning how DNS works",
  ];

  let observer: IntersectionObserver | undefined;

  function setupSubtitle() {
    observer?.disconnect();
    const header = document.querySelector<HTMLElement>(".page-header");
    const subtitle = header?.querySelector<HTMLElement>("[data-header-subtitle]");
    if (!header || !subtitle) return;

    let wasVisible: boolean | undefined;

    // Observe the translated header so native CSS and the JS fallback both work.
    observer = new IntersectionObserver(([entry]) => {
      const visible = entry.isIntersecting && entry.intersectionRatio > 0.01;
      if (visible && wasVisible === false) {
        const candidates = subtitles.filter(text => text !== subtitle.textContent);
        subtitle.textContent = candidates[Math.floor(Math.random() * candidates.length)];
      }
      wasVisible = visible;
    }, { threshold: 0.01 });

    observer.observe(header);
  }

  document.addEventListener("astro:page-load", setupSubtitle);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>

<style>
  @reference "../styles/global.css";

  .header-navigation-panel:popover-open { display: none; }

  @media (max-width: 55rem) {
    .header-desktop-nav { display: none; }
    header-navigation { display: block; }
    .header-navigation-trigger { anchor-name: --header-navigation-trigger; }
    header-navigation:has(:popover-open) .menu-open { display: none; }
    header-navigation:has(:popover-open) .menu-close { display: block; }
    header-navigation:has(:popover-open) .header-navigation-trigger { @apply bg-foreground/5 text-foreground; }
    .header-navigation-panel {
      position: fixed;
      inset: 6rem 1.5rem auto auto;
      width: max-content;
      max-width: calc(100vw - 3rem);
    }
    .header-navigation-panel:popover-open { display: block; }
    .header-navigation-panel a[aria-current="page"] { @apply text-foreground; }
    .header-navigation-panel a::after { @apply content-["→"/""] transition-transform text-primary select-none; }
    .header-navigation-panel a:hover::after, .header-navigation-panel a:focus-visible::after { @apply translate-x-1; }

    @supports (position-area: bottom span-left) {
      .header-navigation-panel {
        position-anchor: --header-navigation-trigger;
        position-area: bottom span-left;
        inset: auto;
        margin-top: 0.5rem;
        position-try-fallbacks: flip-inline;
      }
    }
  }
</style>
