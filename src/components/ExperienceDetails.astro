---
import type { CollectionEntry } from "astro:content";
import { dateOfExperienceForHuman } from "~/utils/date-util";
import {  formatIsoDuration } from "~/utils/duration-util";

type Props = {
  experience: CollectionEntry<"experiences">;
};
const { experience } = Astro.props;

---

<time class="mesh-left" datetime={formatIsoDuration(experience.data.startDate, experience.data.endDate)}>
  {dateOfExperienceForHuman(experience.data.startDate)} — {dateOfExperienceForHuman(experience.data.endDate)}
</time>
<div class="mesh-center pb-3">
  <a class="text-foreground font-semibold" href={`/resume/${experience.id}`}>
    {experience.data.organization}
  </a>
  <ul class="text-xs text-foreground/70 pb-6">
    {experience.data.titles.map((title) => (
      <li>{title}</li>
    ))}
  </ul>
  <p>{experience.data.description}</p>
</div>
