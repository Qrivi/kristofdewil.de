---
import type { CollectionEntry } from "astro:content";
import { dateForComputer, dateOfPostForHuman } from "~/utils/date-util";
import { estimateReadingTime } from "~/utils/duration-util";

type Props = {
  entry: CollectionEntry<"blog">;
};
const { entry } = Astro.props;
const { data } = entry;

const readingTime = estimateReadingTime(entry.body);
---

<time class="mesh-left item-timestamp" datetime={dateForComputer(data.publishDate)}>
  <span class="inline-block" transition:name={`blog-${entry.id}-date`}>{dateOfPostForHuman(data.publishDate)}</span>
</time>
<div class="mesh-center pb-4">
  <a class="text-foreground font-semibold" href={`/blog/${entry.id}`}>
    <span class="inline-block" transition:name={`blog-${entry.id}-title`}>{data.title}</span>
  </a>
  <p class="text-xs text-foreground/70 pb-6">
    <span class="block" transition:name={`blog-${entry.id}-reading-time`}><time datetime={`PT${readingTime}M`}>{readingTime} min</time> read</span>
  </p>
  <p class="font-reading"><span class="block" transition:name={`blog-${entry.id}-description`}>{data.description}</span></p>
</div>
