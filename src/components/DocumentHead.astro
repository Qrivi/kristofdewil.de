---
type Props = {
  title?: string;
  description?: string;
};
const {title, description}: Props = Astro.props;

const defaultTitle = "Kristof Dewilde";
const pageTitle = title ? `${defaultTitle} → ${title}` : defaultTitle;
const pageDescription = description || "Full Stack Java Developer"; // TODO be more original

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const cardUrl = new URL("og_card.png", Astro.site); // TODO Make a card
---

<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>

  <meta name="health-check" content="ok">
  <meta name="generator" content={Astro.generator}/>
  <meta name="description" content={pageDescription}/>

  {/* We will want to make this way more dynamic once we have a blog. We will probably want a small component that renders a beautiful card as HTML, based on the blog
  title and images used -- maybe a oneliner -- then when we generate each page, also generate an image from that HTML card that we can use as og:image. */}
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="nl_BE"/>
  <meta property="og:site_name" content={defaultTitle}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDescription}>
  <meta property="og:image" content={cardUrl}>
  <meta property="og:image:secure_url" content={cardUrl}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content={pageDescription}>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
  <link rel="alternate" type="application/rss+xml" href={new URL("rss.xml", Astro.site)} title="Kristof Dewilde / Blog"/>

  <title>{pageTitle}</title>

  <script>
    import { applyPreferences } from "~/utils/preferences";

    applyPreferences();
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => applyPreferences());
    document.addEventListener("astro:before-swap", (event) => applyPreferences(event.newDocument));
  </script>

  <slot/>
</head>
