---
import type { CollectionEntry } from "astro:content";
import { dateOfCareerForHuman } from "~/utils/date-util";
import {  formatIsoDuration } from "~/utils/duration-util";

type Props = {
  entry: CollectionEntry<"career">;
};
const { entry } = Astro.props;
const { data } = entry;
---

<time class="mesh-left item-timestamp" datetime={formatIsoDuration(data.startDate, data.endDate)}>
  <span class="inline-block" transition:name={`career-${entry.id}-date`}>{dateOfCareerForHuman(data.startDate)} — {dateOfCareerForHuman(data.endDate)}</span>
</time>
<div class="mesh-center pb-4">
  <a class="text-foreground font-semibold" href={`/career/${entry.id}`}>
    <span class="inline-block" transition:name={`career-${entry.id}-organization`}>{data.organization}</span>
  </a>
  <p class="text-xs text-foreground/70 pb-6"><span class="block" transition:name={`career-${entry.id}-role`}>{data.title}</span></p>
  <p class="font-reading"><span class="block" transition:name={`career-${entry.id}-description`}>{data.description}</span></p>
</div>
