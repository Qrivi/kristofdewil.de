---
import type { CollectionEntry } from "astro:content";
import { dateForComputer, dateForHuman } from "~/utils/date-util";
import { estimateReadingTime } from "~/utils/duration-util";

type Props = {
  post: CollectionEntry<"posts">;
};
const { post } = Astro.props;

const readingTime = estimateReadingTime(post.body);
---

<time class="mesh-left" datetime={dateForComputer(post.data.publishDate)}>
  {dateForHuman(post.data.publishDate)}
</time>
<div class="mesh-center">
  <a class="text-foreground font-medium" href={`/posts/${post.id}`}>
    {post.data.title}
  </a>
  <p class="text-sm text-foreground/50">
    <time datetime={`PT${readingTime}M`}>{readingTime} min</time> read
  </p>
  <p>{post.data.description}</p>
</div>
