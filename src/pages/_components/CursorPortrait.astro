---
import type { ImageMetadata } from "astro";

const portraits = import.meta.glob<ImageMetadata>("/src/assets/portrait-rotation/*.webp", { eager: true, import: "default" });
const frames = Object.entries(portraits)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => image.src);
const darkPortraits = import.meta.glob<ImageMetadata>("/src/assets/portrait-rotation-dark/*.webp", { eager: true, import: "default" });
const darkFrames = Object.entries(darkPortraits)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => image.src);
const frontFrame = Math.floor(frames.length / 2);

---

<cursor-portrait class="contents" data-frames={JSON.stringify(frames)} data-dark-frames={JSON.stringify(darkFrames)}>
  <picture class="block aspect-square w-full mix-blend-multiply opacity-40 dark:mix-blend-lighten my-2">
    <source srcset={darkFrames[frontFrame]} media="(prefers-color-scheme: dark)" />
    <img src={frames[frontFrame]} alt="Pencil portrait of Kristof Dewilde" width={512} height={512} draggable="false" class="block aspect-square w-full select-none" />
  </picture>
</cursor-portrait>

<script>
  class CursorPortrait extends HTMLElement {
    private visibilityObserver?: IntersectionObserver;
    private cleanup?: () => void;

    connectedCallback() {
      // Match the previous client:visible hydration behavior.
      const picture = this.querySelector("picture");
      if (!picture) return;
      this.visibilityObserver = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        this.visibilityObserver?.disconnect();
        this.cleanup = this.initialize();
      });
      this.visibilityObserver.observe(picture);
    }

    disconnectedCallback() {
      this.visibilityObserver?.disconnect();
      this.cleanup?.();
      this.cleanup = undefined;
    }

    private initialize() {
      const portrait = this.querySelector("picture")!;
      const image = portrait.querySelector("img")!;
      const source = portrait.querySelector("source")!;
      const frames: string[] = JSON.parse(this.dataset.frames!);
      const darkFrames: string[] = JSON.parse(this.dataset.darkFrames!);
      const frontFrame = Math.floor(frames.length / 2);
      let frame = frontFrame;

      function setFrame(nextFrame: number) {
        if (frame === nextFrame) return;
        frame = nextFrame;
        source.srcset = darkFrames[frame];
        image.src = frames[frame];
      }

      // Respect saved theme overrides as well as the initial media query.
      const syncTheme = () => {
        source.media = document.documentElement.classList.contains("dark") ? "all" : "not all";
      };
      syncTheme();
      const themeObserver = new MutationObserver(syncTheme);
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    const pointer = window.matchMedia("(any-hover: hover) and (any-pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let ready = false;
    let disposed = false;
    let pendingFrame = 0;
    let cursorX: number | null = null;

    // Decode every view before allowing swaps, so moving the cursor never flashes an unloaded image.
    if (pointer.matches && !reducedMotion.matches) preload();

    function preload() {
      void Promise.all(
        [...frames, ...darkFrames].map((src) => {
          const image = new Image();
          image.src = src;
          return image.decode();
        }),
      )
        .then(() => {
          if (!disposed) {
            ready = true;
            scheduleUpdate();
          }
        })
        .catch(() => {
          // Keep the server-rendered front view if a frame cannot load.
        });
    }

    function update() {
      pendingFrame = 0;
      if (!ready || cursorX === null || !pointer.matches || reducedMotion.matches) return;

      const bounds = portrait.getBoundingClientRect();
      const center = bounds.left + bounds.width / 2;
      // Face forward over the portrait, reaching either extreme at the corresponding viewport edge.
      const distance = cursorX - center;
      const range = distance < 0 ? center : window.innerWidth - center;
      const position = Math.max(-1, Math.min(1, distance / Math.max(1, range)));
      setFrame(Math.round(((position + 1) / 2) * (frames.length - 1)));
    }

    function scheduleUpdate() {
      if (!pendingFrame) pendingFrame = window.requestAnimationFrame(update);
    }

    function track(event: PointerEvent) {
      if (event.pointerType === "touch") return;
      cursorX = event.clientX;
      scheduleUpdate();
    }

    function reset() {
      cursorX = null;
      window.cancelAnimationFrame(pendingFrame);
      pendingFrame = 0;
      setFrame(frontFrame);
    }

    function leave(event: PointerEvent) {
      if (event.relatedTarget === null) reset();
    }

    function preferencesChanged() {
      reset();
      if (!ready && pointer.matches && !reducedMotion.matches) preload();
    }

    window.addEventListener("pointermove", track, { passive: true });
    window.addEventListener("pointerout", leave);
    window.addEventListener("blur", reset);
    window.addEventListener("resize", scheduleUpdate);
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    pointer.addEventListener("change", preferencesChanged);
    reducedMotion.addEventListener("change", preferencesChanged);

    return () => {
      themeObserver.disconnect();
      disposed = true;
      window.cancelAnimationFrame(pendingFrame);
      window.removeEventListener("pointermove", track);
      window.removeEventListener("pointerout", leave);
      window.removeEventListener("blur", reset);
      window.removeEventListener("resize", scheduleUpdate);
      window.removeEventListener("scroll", scheduleUpdate);
      pointer.removeEventListener("change", preferencesChanged);
      reducedMotion.removeEventListener("change", preferencesChanged);
    };
    }
  }

  if (!customElements.get("cursor-portrait")) {
    customElements.define("cursor-portrait", CursorPortrait);
  }
</script>
