---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout>
  <main>
    <div class="h-[48dvh] grid place-content-center text-center">
      <p aria-hidden="true" class="font-mono text-2xl">¯\_(ツ)_/¯</p>
      <p id="not-found-message" class="text-sm invisible">The page you are looking for does not exist.</p>

      <script>
        const messages = [
          "The page you are looking for does not exist.",
          "Looks like this endpoint returned nothing but vibes.",
          "Plot twist: the page never existed.",
          "This page segfaulted into the void.",
          "Lost? Same tbh.",
          "NullPointerException: Page not found.",
          "This page never made it to production.",
          "You are here but the page is not.",
          "The cake is a lie. So is this page.",
          "Expected: page. Actual: disappointment."
        ];

        const paragraph = document.getElementById("not-found-message");
        const randomIndex = Math.floor(Math.random() * messages.length);

        if(paragraph) {
          paragraph.textContent = messages[randomIndex];
          paragraph.style.visibility = "visible";
        }
      </script>
    </div>
  </main>
</BaseLayout>
