---
import { getCollection } from "astro:content";
import ExperienceDetails from "~/components/ExperienceDetails.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";

const experiences = (await getCollection("experiences")).sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime();
});
---

<BaseLayout title="Resume">
  <section class="wrapper mesh">
    <h1 class="sr-only">Work experience</h1>
    <ul class="contents">
      {experiences.map((experience) => (
        <li class="contents">
          <ExperienceDetails experience={experience} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
