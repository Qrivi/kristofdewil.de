---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { dateForSummary } from "~/utils/date-util";
import { formatIsoDuration } from "~/utils/duration-util";

const experiences = (await getCollection("experiences")).sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime(); // newest to oldest
});
---

<BaseLayout>
  <main>
    <section class="wrapper">
      <h2 class="title-section">Resume</h2>

      <ul class="grid gap-14">
        {experiences.map(experience =>
          <li>
            <article class="grid gap-1 grid-cols-[12rem_1fr]">
              <div class="grid gap-1">
                <hgroup>
                  <h3 class="title-article">{experience.data.organization}</h3>
                  <p class="uppercase py-2 font-bold text-primary text-xs">{experience.data.titles[0]}</p>
                </hgroup>
                <div class="py-1" set:html={experience.rendered?.html}/>
                <ul class="mt-1 flex flex-wrap text-xs gap-1.5">
                  {experience.data.topics.map(topic => (
                    <li><a class="rounded-sm px-1 font-mono font-medium bg-primary/25 text-primary" href="#">{topic}</a></li>
                  ))}
                </ul>
              </div>
              <aside class="order-first font-mono text-xs space-y-2 pt-2">
                <time class="uppercase block" datetime={formatIsoDuration(experience.data.startDate, experience.data.endDate)}>
                  {dateForSummary(experience.data.startDate)} — {dateForSummary(experience.data.endDate)}
                </time>
                <ul class="space-y-1">
                  {experience.data.locations.map(location => (
                    <li>{location}</li>))}
                </ul>
              </aside>
            </article>
          </li>
        )}
      </ul>
    </section>
  </main>
</BaseLayout>
