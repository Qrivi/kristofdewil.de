---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dateForComputer, dateForHuman } from "../../utils/date-util";
import { estimateReadingTime } from "../../utils/duration-util";

const notes = (await getCollection("posts")).sort((a, b) => {
  const dateA = a.data.editDate ?? a.data.publishDate;
  const dateB = b.data.editDate ?? b.data.publishDate;
  return dateB.getTime() - dateA.getTime(); // newest to oldest
});
---

<BaseLayout>
  <main>
    <section class="wrapper">
      <h2 class="title-section">Notes</h2>

      <ul class="grid gap-14">
        {notes.map(note =>
          <li>
            <article class="grid gap-1">
              <h3 class="title-article"><a class="component-underline" href={`/notes/${note.id}`}>{note.data.title}</a></h3>
              <p class="order-first pb-1 font-mono text-xs uppercase">
                <time datetime={dateForComputer(note.data.publishDate)}>{dateForHuman(note.data.publishDate)}</time>
                / <time datetime={`PT${estimateReadingTime(note.body)}M`}>{estimateReadingTime(note.body)} min</time> read
              </p>
              <p class="leading-8">{note.data.description}</p>
              <ul class="mt-1 flex flex-wrap text-xs gap-1.5">
                {note.data.topics.map(topic=>(
                  <li><a class="rounded-sm px-1 font-mono font-medium bg-primary/25 text-primary" href="#">{topic}</a></li>
                ))}
              </ul>
            </article>
          </li>
        )}
      </ul>
    </section>
  </main>
</BaseLayout>
