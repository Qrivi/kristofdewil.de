---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CareerDetails from "~/components/CareerDetails.astro";
import BlogDetails from "~/components/BlogDetails.astro";
import AboutSection from "./_components/AboutSection.astro";

const limit = 3;

const blogEntries = (await getCollection("blog")).sort((a, b) => {
  const dateA = (a.data.editDate ?? a.data.publishDate).getTime();
  const dateB = (b.data.editDate ?? b.data.publishDate).getTime();
  return dateB - dateA; // newest to oldest
}).slice(0, limit);

const careerEntries = (await getCollection("career")).sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime(); // newest to oldest
}).slice(0, limit);
---

<BaseLayout>
    <AboutSection/>

    <section class="wrapper mesh">
      <h2 class="mesh-center title-section">Recent blog posts</h2>
      <p class="uppercase text-xs">
        <a href="/blog">Read more</a>
      </p>
      <ul class="contents">
        {blogEntries.map(entry => (
          <li class="contents">
            <BlogDetails entry={entry}/>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrapper mesh">
      <h2 class="mesh-center title-section">Recent career highlights</h2>
      <p class="uppercase text-xs">
        <a href="/career">View timeline</a>
      </p>
      <ul class="contents">
        {careerEntries.map(entry => (
          <li class="contents">
            <CareerDetails entry={entry}/>
          </li>
        ))}
      </ul>
    </section>
</BaseLayout>
