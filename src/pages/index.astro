---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ExperienceDetails from "~/pages/_components/ExperienceDetails.astro";
import PostDetails from "~/pages/_components/PostDetails.astro";
import AboutSection from "./_components/AboutSection.astro";

const limit = 3;

const posts = (await getCollection("posts")).sort((a, b) => {
  const dateA = (a.data.editDate ?? a.data.publishDate).getTime();
  const dateB = (b.data.editDate ?? b.data.publishDate).getTime();
  return dateB - dateA; // newest to oldest
}).slice(0, limit);

const experiences = (await getCollection("experiences")).sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime(); // newest to oldest
}).slice(0, limit);
---

<BaseLayout>
    <AboutSection/>

    <section class="wrapper mesh">
      <h2 class="mesh-center">Recent blog posts</h2>
      <p class="uppercase text-xs">
        <a href="/posts">Read more</a>
      </p>
      <ul class="contents">
        {posts.map(post => (
          <li class="contents">
            <PostDetails post={post}/>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrapper mesh">
      <h2 class="mesh-center">Recent work experience</h2>
      <p class="uppercase text-xs">
        <a href="/resume">Full resume</a>
      </p>
      <ul class="contents">
        {experiences.map(experience => (
          <li class="contents">
            <ExperienceDetails experience={experience}/>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrapper mesh">
      <div class="mesh-left">hello 1</div>
      <div class="mesh-center">hello 2</div>
      <div class="mesh-right">hello 3</div>
    </section>
</BaseLayout>
