---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dateForComputer, dateOfPostForHuman } from "~/utils/date-util";
import { estimateReadingTime } from "~/utils/duration-util";
import { isPublishedPost } from "~/utils/blog-util";

export async function getStaticPaths() {
  const entries = await getCollection("blog", isPublishedPost);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const readingTime = estimateReadingTime(entry.body);
---

<BaseLayout
  title={data.title}
  description={data.description}
  structuredData={{ type: "BlogPosting", entry }}>
  <article class="wrapper mesh">
    <header class="contents">
      <hgroup class="title-page">
        <h1><span class="inline-block" transition:name={`blog-${entry.id}-title`}>{data.title}</span></h1>
        <p><span class="block" transition:name={`blog-${entry.id}-reading-time`}><time datetime={`PT${readingTime}M`}>{readingTime} min</time> read</span></p>
      </hgroup>
      <p class="mesh-center text-base/7 border-b border-foreground/10 pt-4 pb-10 sm:pb-20 mb-10"><span class="block" transition:name={`blog-${entry.id}-description`}>{data.description}</span></p>
      <time class="mesh-left item-timestamp -order-1 self-end pb-13 max-desktop:pb-4" datetime={dateForComputer(data.publishDate)}><span class="inline-block" transition:name={`blog-${entry.id}-date`}>{dateOfPostForHuman(data.publishDate)}</span></time>
    </header>

    <div class="component-content">
      <Content/>
    </div>
  </article>
</BaseLayout>
