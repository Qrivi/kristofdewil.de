---
import { getCollection } from "astro:content";
import BlogDetails from "~/components/BlogDetails.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { isPublishedPost } from "~/utils/blog-util";

const entries = (await getCollection("blog", isPublishedPost)) //
  .sort((a, b) => {
  const dateA = (a.data.editDate ?? a.data.publishDate).getTime();
  const dateB = (b.data.editDate ?? b.data.publishDate).getTime();
  return dateB - dateA; // newest to oldest
});

const contentTitle = "Things I’ve built, fixed, and figured out.";
---

<BaseLayout
  title="Blog"
  description={contentTitle}
  structuredData={{ type: "CollectionPage", items: entries.map(entry => ({ name: entry.data.title, path: `/blog/${entry.id}` })) }}
>
  <section class="wrapper mesh">
    <header class="contents">
      <hgroup class="title-page mb-10 sm:mb-16">
        <h1>Blog</h1>
        <p>{contentTitle}</p>
      </hgroup>
    </header>

    <ul class="contents">
      {entries.map(entry => (
        <li class="contents">
          <BlogDetails entry={entry}/>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
