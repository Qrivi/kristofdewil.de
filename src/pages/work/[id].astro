---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { dateForComputer, dateOfExperienceForHuman } from "~/utils/date-util";
import TechnologyStack from "./_components/TechnologyStack.astro";

export async function getStaticPaths() {
  const experiences = await getCollection("experiences");
  return experiences.map((experience) => ({
    params: { id: experience.id },
    props: { experience },
  }));
}

const { experience } = Astro.props;
const { organization, description, titles, startDate, endDate, locations, link, logo, locationMap, technologies, summary } = experience.data;
const { Content } = await render(experience);
const hasContent = Boolean(experience.body?.trim());
const website = new URL(link).hostname.replace(/^www\./, "");
---

<BaseLayout title={organization}>
  <article class="wrapper mesh experience gap-y-0 pt-8 pb-24">
    <nav class="mesh-center experience-back row-1 mb-12 text-xs" aria-label="Back to resume">
      <a class="inline-flex items-center gap-2 hover:text-foreground" href="/work"><span class="text-primary" aria-hidden="true">←</span> All experience</a>
    </nav>

    <div class="experience-identity col-[left] row-2 flex justify-end pt-7">
      <Image class="size-18 shrink-0 object-contain rounded-xl bg-white" src={logo} alt={`${organization} logo`} width={72} densities={[1, 2]} />
    </div>

    <header class="mesh-center row-2">
      <p class="font-mono uppercase text-[0.625rem] tracking-widest pb-3">Work experience</p>
      <h1 class="text-4xl sm:text-5xl tracking-tight leading-[1.1] mb-4">{organization}</h1>
      <ul class="p-0 text-base/6 text-foreground">{titles.map((title) => <li>{title}</li>)}</ul>
      <dl class="flex flex-wrap gap-x-5 gap-y-1 pt-3 text-xs/6 text-foreground/70">
        {locations.length > 0 && <div>
          <dt class="sr-only">Location</dt>
          <dd>{locations.join(" · ")}</dd>
        </div>}
        <div>
          <dt class="sr-only">Organization website</dt>
          <dd><a class="inline-flex items-center gap-1.5 max-w-full break-all hover:underline decoration-primary underline-offset-4" href={link} rel="nofollow noopener noreferrer" target="_blank">{website}<span class="text-primary" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></dd>
        </div>
      </dl>
      <p class="experience-intro font-reading text-base/7 pt-6 pb-10">{description}</p>
    </header>

    <aside class="experience-context col-[left] row-3 text-right" aria-label="Period and location map">
      <div class="mesh-left">
        <time datetime={dateForComputer(startDate)}>{dateOfExperienceForHuman(startDate)}</time>
        <span aria-hidden="true"> — </span><span class="sr-only"> to </span>
        {endDate ? <time datetime={dateForComputer(endDate)}>{dateOfExperienceForHuman(endDate)}</time> : "Present"}
      </div>
      <a class="experience-map block mt-7" href={locationMap.link} rel="noopener noreferrer" target="_blank" aria-label="Explore the location on OpenStreetMap (opens in a new tab)">
        <img class="w-full h-auto" src={locationMap.image} alt={locationMap.alt} width="200" height="175" />
        <span class="text-[0.625rem] text-foreground/60 inline-flex items-center gap-1 hover:text-foreground">Explore location <span aria-hidden="true">↗</span></span>
      </a>
    </aside>

    <div class="mesh-center row-3">
      {hasContent && <section class="experience-overview pb-8" aria-labelledby="overview-title">
        <h2 id="overview-title" class="title-section pb-6">Overview</h2>
        <div class="component-content block"><Content /></div>
      </section>}

      {summary.length > 0 && <section aria-labelledby="contributions-title" class="experience-contributions">
        <h2 id="contributions-title" class="title-section pb-6">Contributions</h2>
        <ul class="font-reading p-0 list-none">{summary.map((item) => <li class="relative pl-5 pb-5">{item}</li>)}</ul>
      </section>}
    </div>

    <aside class="experience-tools col-[right] row-3 min-w-0" aria-label="Technology stack">
      <TechnologyStack technologies={technologies} />
    </aside>
  </article>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .experience-contributions li::before { @apply absolute left-0 top-2.5 w-1 h-1 bg-primary rounded-full; content: ""; }

  /* Keep rendered Markdown inside the reading column, including future rich content. */
  .experience-overview :global(pre) { max-width: 100%; width: 100%; }

  @media (max-width: 55rem) {
    .experience-tools { grid-column: center; grid-row: 4; @apply pt-8; }
  }

  @media (max-width: 40rem) {
    .experience { @apply pt-6; }
    .experience > * { grid-row: auto; }
    .experience-back { @apply mb-8; }
    .experience-identity { @apply justify-start pt-0 mb-6; }
    .experience-identity :global(img) { @apply size-14; }
    .experience-intro { @apply pb-7; }
    .experience-context { @apply text-left mb-6; }
    .experience-map { @apply hidden; }
  }
</style>
