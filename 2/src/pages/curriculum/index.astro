<style lang="scss">
  h2 {
    padding: 2em 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 2.4em;
    text-transform: uppercase;
    line-height: 1.4em;
    color: var(--color-title);
  }

  article {
    display: flex;
    column-gap: 2em;

    &.nested .timeline {
      border-right: none;
      padding: 1em calc(2em + 30px) 1em 0;

      &::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: 0;
        right: -1px;
        width: 29px;
        height: 100%;
        border-left: dashed 1px var(--color-background-lighter);
        border-right: solid 1px var(--color-background-lighter);
      }
    }

    &.first.nested .timeline::before {
      border-bottom-right-radius: 100px;
      border-bottom: solid 1px var(--color-background-lighter);
    }

    .timeline {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      flex: 0 0 200px;
      padding: 1em 2em 1em 0;
      border-right: solid 1px var(--color-background-lighter);

      &::after {
        content: "";
        position: absolute;
        top: 1.4em;
        right: -6px;
        width: 11px;
        height: 11px;
        background: var(--color-accent);
        border-radius: 100%;
      }

      time {
        font-weight: 700;
        text-transform: uppercase;
      }
    }

    .details {
      width: 100%;
      padding: 1em 0;

      h3 {
        font-family: var(--font-title);
        font-weight: 700;
        font-size: 1.4em;
        color: var(--color-title);
      }

      p {
        padding: 1em 0 0.5em;
      }
    }

    aside {
      width: 100%;
      padding: 1em 0;
    }
  }
</style>
