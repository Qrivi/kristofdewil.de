<style lang="scss">
  div {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    opacity: 0;
    animation: 500ms ease-out 100ms forwards normal fade;

    figure {
      position: absolute;
      z-index: 1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      margin: 0;
      padding: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &::before {
      position: absolute;
      z-index: 2;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: var(--color-background);
      opacity: 0.8;
      content: "";
    }

    &::after {
      position: absolute;
      z-index: 2;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: var(--color-background-lighter);
      opacity: 0.15;
      content: "";
    }

    header {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-items: center;
      align-items: center;
      padding: 150px 0; // TODO temp

      h1 {
        margin: 1em 0;
        width: 6em;
        line-height: 1em;
        letter-spacing: 0.1em;
        font-size: 2.8em;
        font-family: var(--font-title);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-title);

        span {
          display: block;
          text-align: right;
        }
      }

      em {
        display: block;
        font-family: var(--font-title);
        letter-spacing: 0.1em;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--color-accent);
      }
    }
  }
</style>
