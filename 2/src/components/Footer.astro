---
import ContentWrapper from "./ContentWrapper.astro";
import SiteName from "./SiteName.astro";
import DarkModeToggle from "./DarkModeToggle.vue";
---

<footer>
  <ContentWrapper>
    <div>
      <SiteName />
      <DarkModeToggle client:only="vue" />
    </div>
    <div>
      <ul>
        <li>
          <a
            target="_blank"
            class="inverting github"
            href="https://github.com/Qrivi"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            target="_blank"
            class="inverting instagram"
            href="https://instagram.com/Qrivi"
          >
            Instagram
          </a>
        </li>
        <li>
          <a
            target="_blank"
            class="inverting spotify"
            href="https://open.spotify.com/user/Qrivi"
          >
            Spotify
          </a>
        </li>
        <li>
          <a
            target="_blank"
            class="inverting twitter"
            href="https://twitter.com/Qrivi"
          >
            Twitter
          </a>
        </li>
      </ul>
    </div>
  </ContentWrapper>
</footer>

<style lang="scss">
  footer {
    margin-top: 100px;
    background: var(--color-background-darker);

    div {
      display: flex;
      justify-content: space-between;
      align-items: center;

      ul {
        display: flex;
        gap: 10px;
        margin: 50px 0;

        li {
          width: 40px;
          height: 40px;
          border-radius: 5px;
          margin: 0;
          padding: 0;
          background: var(--color-background);
          transition: background-color 250ms ease-out;

          &:hover {
            background: var(--color-accent);
          }

          a {
            position: relative;
            display: block;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            text-indent: 100%;
            white-space: nowrap;
            overflow: hidden;
            background-size: 33.333%;
            background-repeat: no-repeat;
            background-position: center;

            &.spotify {
              background-image: url("/icons/spotify.svg");
            }
            &.instagram {
              background-image: url("/icons/instagram.svg");
            }
            &.github {
              background-image: url("/icons/github.svg");
            }
            &.twitter {
              background-image: url("/icons/twitter.svg");
            }
          }
        }
      }
    }
  }
</style>
